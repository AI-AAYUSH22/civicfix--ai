# CivicFix AI Environment Configuration
API_V1_STR=/api/v1
PROJECT_NAME="CivicFix AI"

# Database Configuration (SQLite default for local setup; PostgreSQL + PostGIS in production)
DATABASE_URL=sqlite:///./civicfix.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicfix

# Security
SECRET_KEY=civicfix-secret-key-change-in-production-2026-hackathon
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=./uploads

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Verification Thresholds
GPS_PASS_DISTANCE_METERS=15.0
GPS_REVIEW_DISTANCE_METERS=35.0
HOMOGRAPHY_INLIER_MIN=10
POTHOLE_REPAIRED_THRESHOLD=0.65
